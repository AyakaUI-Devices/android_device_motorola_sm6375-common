get_prop(vendor_qti_init_shell, vendor_qc_aon_prop)

# QTI init scripts probe platform properties they do not need.
dontaudit vendor_qti_init_shell { system_prop default_prop }:file { getattr open read map };

# init.qti.irq_affinity.sh walks /proc/irq to pin device interrupts.
allow vendor_qti_init_shell proc:dir r_dir_perms;
